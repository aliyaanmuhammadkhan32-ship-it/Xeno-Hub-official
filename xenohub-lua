-- Sharp Box Toggle Module Builder
local function CreateSquareModule(text, callback)
    local Btn = Instance.new("TextButton")
    Btn.BackgroundColor3 = Color3.fromRGB(22, 22, 28)
    Btn.BorderSizePixel = 1
    Btn.BorderColor3 = Color3.fromRGB(45, 45, 55)
    Btn.Font = Enum.Font.Code
    Btn.Text = text
    Btn.TextColor3 = Color3.fromRGB(200, 200, 200)
    Btn.TextSize = 14
    Btn.Parent = GridContainer
    
    Btn.MouseButton1Click:Connect(function()
        local active = callback()
        if active then
            Btn.BackgroundColor3 = Color3.fromRGB(0, 40, 25)
            Btn.BorderColor3 = Color3.fromRGB(0, 255, 150)
            Btn.TextColor3 = Color3.fromRGB(0, 255, 150)
        else
            Btn.BackgroundColor3 = Color3.fromRGB(22, 22, 28)
            Btn.BorderColor3 = Color3.fromRGB(45, 45, 55)
            Btn.TextColor3 = Color3.fromRGB(200, 200, 200)
        end
    end)
    return Btn
end

-- Fixed Modules Execution Logic
CreateSquareModule("TOGGLE FLY", function()
    flying = not flying
    if flying and RootPart then
        local bg = Instance.new("BodyGyro", RootPart)
        bg.P = 9e4
        bg.maxTorque = Vector3.new(9e9, 9e9, 9e9)
        bg.cframe = RootPart.CFrame
        
        local bv = Instance.new("BodyVelocity", RootPart)
        bv.velocity = Vector3.new(0, 0.1, 0)
        bv.maxForce = Vector3.new(9e9, 9e9, 9e9)
        
        task.spawn(function()
            while flying and task.wait() and RootPart do
                local cam = workspace.CurrentCamera.CFrame
                local moveDirection = Vector3.new()
                
                if uis:IsKeyDown(Enum.KeyCode.W) then moveDirection = moveDirection + cam.LookVector end
                if uis:IsKeyDown(Enum.KeyCode.S) then moveDirection = moveDirection - cam.LookVector end
                if uis:IsKeyDown(Enum.KeyCode.A) then moveDirection = moveDirection - cam.RightVector end
                if uis:IsKeyDown(Enum.KeyCode.D) then moveDirection = moveDirection + cam.RightVector end
                
                bv.velocity = moveDirection * flySpeed
                bg.cframe = cam
            end
            if bg then bg:Destroy() end
            if bv then bv:Destroy() end
        end)
    end
    return flying
end)

CreateSquareModule("NOCLIP", function()
    noclip = not noclip
    return noclip
end)

CreateSquareModule("INVISIBILITY", function()
    invisible = not invisible
    if Character then
        for _, part in pairs(Character:GetChildren()) do
            if part:IsA("BasePart") and part.Name ~= "HumanoidRootPart" then
                part.Transparency = invisible and 1 or 0
            elseif part:IsA("Accessory") and part:FindFirstChild("Handle") then
                part.Handle.Transparency = invisible and 1 or 0
            end
        end
        if Character:FindFirstChild("Head") and Character.Head:FindFirstChild("face") then
            Character.Head.face.Transparency = invisible and 1 or 0
        end
    end
    return invisible
end)

CreateSquareModule("GOD MODE", function()
    godMode = not godMode
    if Humanoid then
        if godMode then
            Humanoid.MaxHealth = math.huge
            Humanoid.Health = math.huge
        else
            Humanoid.MaxHealth = 100
            Humanoid.Health = 100
        end
    end
    return godMode
end)

CreateSquareModule("FAST SPEED", function()
    if Humanoid then
        if currentSpeed == 16 then
            currentSpeed = 120
        else
            currentSpeed = 16
        end
        Humanoid.WalkSpeed = currentSpeed
    end
    return (currentSpeed > 16)
end)

CreateSquareModule("MEGA JUMP", function()
    if Humanoid then
        if currentJump == 50 then
            currentJump = 180
        else
            currentJump = 50
        end
        Humanoid.JumpPower = currentJump
    end
    return (currentJump > 50)
end)

-- Open/Close Dashboard Control
uis.InputBegan:Connect(function(input, processed)
    if not processed and input.KeyCode == Enum.KeyCode.Insert then
        MainFrame.Visible = not MainFrame.Visible
    end
end)
