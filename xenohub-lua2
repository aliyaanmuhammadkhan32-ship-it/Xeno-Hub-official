-- Xeno Hub V2 Independent Execution Patch
local CoreGui = game:GetService("CoreGui")
local Players = game:GetService("Players")
local Player = Players.LocalPlayer
local RunService = game:GetService("RunService")
local uis = game:GetService("UserInputService")

if CoreGui:FindFirstChild("XenoSpaceAdminV2") then
    CoreGui.XenoSpaceAdminV2:Destroy()
end

local UI = Instance.new("ScreenGui")
UI.Name = "XenoSpaceAdminV2"
UI.Parent = CoreGui
UI.ResetOnSpawn = false

-- Engine Memory Anchors
local flying, noclip, invisible, godMode = false, false, false, false
local currentSpeed, currentJump, flySpeed = 16, 50, 75

local Character = Player.Character or Player.CharacterAdded:Wait()
local Humanoid = Character:WaitForChild("Humanoid")
local RootPart = Character:WaitForChild("HumanoidRootPart")

Player.CharacterAdded:Connect(function(newChar)
    Character = newChar
    Humanoid = newChar:WaitForChild("Humanoid")
    RootPart = newChar:WaitForChild("HumanoidRootPart")
    task.wait(0.1)
    Humanoid.WalkSpeed = currentSpeed
    Humanoid.JumpPower = currentJump
    if godMode then Humanoid.MaxHealth = 999999 Humanoid.Health = 999999 end
end)

RunService.Stepped:Connect(function()
    if noclip and Character then
        for _, part in pairs(Character:GetChildren()) do
            if part:IsA("BasePart") then part.CanCollide = false end
        end
    end
end)

