local function CreateToggleModule(name, callback)
    local Btn = Instance.new("TextButton")
    Btn.BackgroundColor3 = Color3.fromRGB(24, 24, 32)
    Btn.BorderSizePixel = 1
    Btn.BorderColor3 = Color3.fromRGB(45, 45, 55)
    Btn.Font = Enum.Font.Code
    Btn.Text = name .. " [OFF]"
    Btn.TextColor3 = Color3.fromRGB(180, 180, 180)
    Btn.TextSize = 12
    Btn.Parent = Container
    
    local state = false
    Btn.MouseButton1Click:Connect(function()
        state = not state
        callback(state)
        if state then
            Btn.Text = name .. " [ON]"
            Btn.BackgroundColor3 = Color3.fromRGB(0, 40, 20)
            Btn.BorderColor3 = Color3.fromRGB(0, 255, 150)
            Btn.TextColor3 = Color3.fromRGB(0, 255, 150)
        else
            Btn.Text = name .. " [OFF]"
            Btn.BackgroundColor3 = Color3.fromRGB(24, 24, 32)
            Btn.BorderColor3 = Color3.fromRGB(45, 45, 55)
            Btn.TextColor3 = Color3.fromRGB(180, 180, 180)
        end
    end)
end

-- Wire Actions
CreateToggleModule("FLIGHT MODE", function(val)
    flying = val
    if flying and RootPart then
        local bg = Instance.new("BodyGyro", RootPart)
        bg.P = 9e4 bg.maxTorque = Vector3.new(9e9, 9e9, 9e9) bg.cframe = RootPart.CFrame
        local bv = Instance.new("BodyVelocity", RootPart)
        bv.velocity = Vector3.new(0, 0.1, 0) bv.maxForce = Vector3.new(9e9, 9e9, 9e9)
        task.spawn(function()
            while flying and task.wait() and RootPart do
                local cam = workspace.CurrentCamera.CFrame
                local moveDir = Vector3.new()
                if uis:IsKeyDown(Enum.KeyCode.W) then moveDir = moveDir + cam.LookVector end
                if uis:IsKeyDown(Enum.KeyCode.S) then moveDir = moveDir - cam.LookVector end
                if uis:IsKeyDown(Enum.KeyCode.A) then moveDir = moveDir - cam.RightVector end
                if uis:IsKeyDown(Enum.KeyCode.D) then moveDir = moveDir + cam.RightVector end
                bv.velocity = moveDir * flySpeed bg.cframe = cam
            end
            if bg then bg:Destroy() end if bv then bv:Destroy() end
        end)
    end
end)

CreateToggleModule("NOCLIP WALLS", function(val) noclip = val end)
CreateToggleModule("GOD MODE", function(val)
    godMode = val
    if Humanoid then
        Humanoid.MaxHealth = godMode and 999999 or 100
        Humanoid.Health = godMode and 999999 or 100
    end
end)

CreateToggleModule("FAST SPEED", function(val)
    currentSpeed = val and 120 or 16
    if Humanoid then Humanoid.WalkSpeed = currentSpeed end
end)

CreateToggleModule("MEGA JUMP", function(val)
    currentJump = val and 180 or 50
    if Humanoid then Humanoid.JumpPower = currentJump end
end)

uis.InputBegan:Connect(function(input, processed)
    if not processed and input.KeyCode == Enum.KeyCode.Insert then
        MainFrame.Visible = not MainFrame.Visible
    end
end)
